{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wearday-suggest",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "ai": { "binding": "AI" },
  "observability": { "enabled": true },

  // Per-IP limit to protect your free daily AI allowance: 10 suggestions a minute.
  // namespace_id is any number you choose that is unique within your account.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]

  // Optional: pick a cheaper or different model.
  // "vars": { "MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8" }
}
