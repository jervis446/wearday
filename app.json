{
  "expo": {
    "name": "Wearday",
    "slug": "wearday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wearday.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2603E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wearday.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Wearday"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to add clothes and outfit selfies.",
          "cameraPermission": "Allow camera access to photograph clothes and outfit selfies."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wearday uses your approximate location to check today’s weather for outfit suggestions."
        }
      ]
    ],
    "scheme": "wearday",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3EE"
    }
  }
}
