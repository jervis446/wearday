# Copy to .env and fill in. Everything here is optional: without a value the related feature is
# simply hidden and the app keeps working offline. All of these are public client keys (safe to ship).

# Accounts & sync (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Which sign-in buttons to show (comma-separated): apple, google, email
EXPO_PUBLIC_AUTH_PROVIDERS=apple,google,email

# AI outfit suggestions (the Cloudflare Worker in ./worker)
EXPO_PUBLIC_SUGGEST_URL=https://wearday-suggest.<your-subdomain>.workers.dev
EXPO_PUBLIC_SUGGEST_TOKEN=

# Usage analytics (PostHog → Project settings → Project API key)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Premium (RevenueCat → Project settings → API keys → public app-specific SDK keys)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
# Development only: show sample prices on the paywall where the store isn't available (web)
# EXPO_PUBLIC_PAYWALL_PREVIEW=1
